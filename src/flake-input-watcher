#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: flake-input-watcher [check|list-inputs] [--config PATH] [--dry-run]

Check direct flake.lock inputs against their upstream Git refs.
--dry-run prints results without running hooks or writing state.
Configuration defaults to $XDG_CONFIG_HOME/flake-input-watcher/config.json.
EOF
}

die() {
	printf 'flake-input-watcher: %s\n' "$*" >&2
	exit 1
}
log() { printf 'flake-input-watcher: %s\n' "$*" >&2; }

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/flake-input-watcher/config.json"
operation=check
operation_set=false
dry_run=false
while (($#)); do
	case "$1" in
	check | list-inputs)
		"$operation_set" && die 'only one operation is allowed'
		operation=$1
		operation_set=true
		shift
		;;
	--config)
		(($# >= 2)) || die '--config requires a path'
		config_file=$2
		shift 2
		;;
	--dry-run)
		dry_run=true
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	*) die "unknown argument: $1" ;;
	esac
done

umask 077
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/flake-input-watcher.XXXXXXXX")
trap 'rm -rf -- "$work_dir"' EXIT
cp -- "$config_file" "$work_dir/config.json" || die "cannot read configuration: $config_file"
config_file="$work_dir/config.json"

# Runtime configuration contains executable hook paths, never shell source.
jq -e '
    type == "object" and
    (.flakePath | type == "string" and startswith("/")) and
    ((.inputs // {}) | type == "object" and all(.[]; .enable | type == "boolean")) and
    ((.hooks // {}) | type == "object" and all(.[];
        .type == "notify" or (.type == "shell" and (.command | type == "string" and startswith("/"))))) and
    ((.rules // []) | type == "array" and all(.[];
        (.inputs | type == "array" and all(.[]; type == "string")) and
        (.hooks | type == "array" and all(.[]; type == "string")))) and
    ((.requestTimeout // 30) | type == "number" and . > 0 and floor == .) and
    ((.hookTimeout // 60) | type == "number" and . > 0 and floor == .) and
    (. as $cfg | all(($cfg.rules // [])[] | .hooks[]; $cfg.hooks[.] != null))
' "$config_file" >/dev/null || die 'invalid configuration or undefined hook in rules'

flake_path=$(jq -r '.flakePath' "$config_file")
flake_path=$(cd -- "$flake_path" && pwd -P) || die 'flake directory does not exist'
cp -- "$flake_path/flake.lock" "$work_dir/flake.lock" || die 'cannot read flake.lock'
request_timeout=$(jq -r '.requestTimeout // 30' "$config_file")
hook_timeout=$(jq -r '.hookTimeout // 60' "$config_file")

# Follows paths start at the root and may themselves traverse aliases.
# Track array references to reject cycles without depending on node names.
jq -c --slurpfile cfg "$config_file" '
    . as $lock |
    def resolve($value; $seen):
        if ($value | type) == "string" then
            if $lock.nodes[$value] == null then error("missing lock node: " + $value) else $value end
        elif ($value | type) == "array" then
            ($value | tojson) as $key |
            if ($seen | index($key)) != null then error("cyclic follows") else
                reduce $value[] as $part ($lock.root;
                    resolve($lock.nodes[.].inputs[$part]; $seen + [$key]))
            end
        else error("invalid input reference") end;
    if .version != 7 or (.nodes[.root].inputs | type) != "object" then
        error("unsupported or invalid flake.lock") else . end |
    .nodes[.root].inputs | to_entries[] |
    .key as $name |
    try (
        resolve(.value; []) as $node |
        $lock.nodes[$node] as $entry |
        # jq // treats false as absent; test key presence explicitly.
        {input: $name, node: $node, original: $entry.original, lockedRev: $entry.locked.rev,
         enabled: (if $cfg[0].inputs[$name] | has("enable") then $cfg[0].inputs[$name].enable else true end)}
    ) catch {input: $name, status: "error", reason: .}
' "$work_dir/flake.lock" >"$work_dir/inputs.jsonl" || die 'invalid flake.lock'

describe_input() {
	local entry=$1 original kind source ref
	if [[ $(jq -r '.status // ""' <<<"$entry") == error ]]; then
		printf '%s\n' "$entry"
		return
	fi
	original=$(jq -c '.original // {}' <<<"$entry")
	kind=$(jq -r '.type // ""' <<<"$original")
	ref=$(jq -r '.ref // "HEAD"' <<<"$original")
	source=''
	case "$kind" in
	github)
		source=$(jq -r '"https://" + (.host // "github.com") + "/" + .owner + "/" + .repo + ".git"' <<<"$original")
		;;
	git) source=$(jq -r '.url // ""' <<<"$original") ;;
	esac
	local status=ready reason=''
	if [[ $(jq -r '.enabled' <<<"$entry") == false ]]; then
		status=skipped
		reason=disabled
	elif [[ $(jq -r '.rev // ""' <<<"$original") != '' ]]; then
		status=skipped
		reason='pinned revision'
	elif [[ -z $source ]]; then
		status=skipped
		reason="unsupported input type: $kind"
	elif [[ ! $(jq -r '.lockedRev // ""' <<<"$entry") =~ ^[[:xdigit:]]{40,64}$ ]]; then
		status=error
		reason='missing or invalid locked Git revision'
	fi
	jq -c --arg source "$source" --arg ref "$ref" --arg status "$status" --arg reason "$reason" \
		'del(.original) + {source:$source, ref:$ref, status:$status, reason:$reason}' <<<"$entry"
}

while IFS= read -r entry; do
	describe_input "$entry"
done <"$work_dir/inputs.jsonl" >"$work_dir/described.jsonl"

if [[ $operation == list-inputs ]]; then
	jq -s '.' "$work_dir/described.jsonl"
	exit 0
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/flake-input-watcher"
if ! "$dry_run"; then
	mkdir -p -- "$state_dir"
	exec 9>"$state_dir/check.lock"
	if ! flock -n 9; then
		log 'another check is running; skipped'
		exit 0
	fi
fi
state_file="$state_dir/state.json"
if [[ -f $state_file ]]; then
	cp -- "$state_file" "$work_dir/state.json"
	jq -e '.version == 1 and (.completed | type == "object")' "$work_dir/state.json" >/dev/null || die 'invalid state file'
else
	printf '{"version":1,"completed":{}}\n' >"$work_dir/state.json"
fi

record_success() {
	local key=$1 state_tmp
	jq --arg key "$key" '.completed[$key] = true' "$work_dir/state.json" >"$work_dir/state.next"
	mv -- "$work_dir/state.next" "$work_dir/state.json"
	state_tmp=$(mktemp "$state_dir/.state.XXXXXXXX")
	cp -- "$work_dir/state.json" "$state_tmp"
	mv -f -- "$state_tmp" "$state_file"
}

remote_revision() {
	local source=$1 ref=$2 output oid name branch='' tag='' peeled='' exact=''
	local -a refs=()
	case "$ref" in
	HEAD) refs=(HEAD) ;;
	refs/*) refs=("$ref" "${ref}^{}") ;;
	*) refs=("refs/heads/$ref" "refs/tags/$ref" "refs/tags/${ref}^{}") ;;
	esac
	if ! output=$(timeout --kill-after=5 "$request_timeout" \
		env GIT_TERMINAL_PROMPT=0 git -c credential.interactive=never \
		ls-remote --exit-code -- "$source" "${refs[@]}" </dev/null); then
		return 1
	fi
	while read -r oid name; do
		[[ $oid =~ ^[[:xdigit:]]{40,64}$ ]] || continue
		if [[ $name == "refs/heads/$ref" ]]; then branch=$oid; fi
		if [[ $name == "refs/tags/$ref" ]]; then tag=$oid; fi
		if [[ $name == "refs/tags/${ref}^{}" || $name == "${ref}^{}" ]]; then peeled=$oid; fi
		if [[ $name == "$ref" ]]; then exact=$oid; fi
	done <<<"$output"
	oid=${branch:-${peeled:-${tag:-$exact}}}
	[[ -n $oid ]] || return 1
	printf '%s\n' "$oid"
}

failures=0
: >"$work_dir/results.jsonl"
: >"$work_dir/notifications.jsonl"
while IFS= read -r entry; do
	input=$(jq -r '.input' <<<"$entry")
	status=$(jq -r '.status' <<<"$entry")
	if [[ $status != ready ]]; then
		log "$input: $status ($(jq -r '.reason' <<<"$entry"))"
		[[ $status != error ]] || failures=$((failures + 1))
		printf '%s\n' "$entry" >>"$work_dir/results.jsonl"
		continue
	fi
	source=$(jq -r '.source' <<<"$entry")
	ref=$(jq -r '.ref' <<<"$entry")
	locked_rev=$(jq -r '.lockedRev' <<<"$entry")
	if ! remote_rev=$(remote_revision "$source" "$ref"); then
		log "$input: upstream query failed ($source, $ref)"
		failures=$((failures + 1))
		jq -c '.status = "error" | .reason = "upstream query failed"' <<<"$entry" >>"$work_dir/results.jsonl"
		continue
	fi
	status=current
	[[ $remote_rev == "$locked_rev" ]] || status=update
	entry=$(jq -c --arg rev "$remote_rev" --arg status "$status" '.remoteRev=$rev | .status=$status' <<<"$entry")
	printf '%s\n' "$entry" >>"$work_dir/results.jsonl"
	[[ $status == update ]] || continue

	mapfile -t hooks < <(jq -r --arg input "$input" '
        [(.rules // [])[] | select(.inputs | any(. == "*" or . == $input)) | .hooks[]] | unique[]
    ' "$config_file")
	for hook in "${hooks[@]}"; do
		event=$(jq -c --arg flake "$flake_path" --arg hook "$hook" \
			'{flake:$flake,input,source,ref,lockedRev,remoteRev,hook:$hook}' <<<"$entry")
		key=$(printf '%s' "$event" | sha256sum)
		key=${key%% *}
		if jq -e --arg key "$key" '.completed[$key] == true' "$work_dir/state.json" >/dev/null; then continue; fi
		"$dry_run" && continue
		hook_type=$(jq -r --arg hook "$hook" '.hooks[$hook].type' "$config_file")
		if [[ $hook_type == notify ]]; then
			jq -c --arg key "$key" '. + {key:$key}' <<<"$event" >>"$work_dir/notifications.jsonl"
			continue
		fi
		hook_command=$(jq -r --arg hook "$hook" '.hooks[$hook].command' "$config_file")
		if (
			cd -- "$flake_path"
			timeout --kill-after=5 "$hook_timeout" env \
				FLAKE_PATH="$flake_path" FLAKE_INPUT_NAME="$input" FLAKE_INPUT_SOURCE="$source" \
				FLAKE_INPUT_REF="$ref" FLAKE_LOCKED_REV="$locked_rev" FLAKE_REMOTE_REV="$remote_rev" \
				"$hook_command" 9>&- </dev/null >&2
		); then
			record_success "$key"
		else
			log "$input: hook $hook failed"
			failures=$((failures + 1))
		fi
	done
done <"$work_dir/described.jsonl"

if [[ -s $work_dir/notifications.jsonl ]]; then
	# Escape input-controlled text because fnott supports notification markup.
	body=$(jq -sr '
        def escape: gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;");
        unique_by(.input) | map(
            "\(.input | escape) [\(.ref | escape)]\n\(.lockedRev[0:12]) → \(.remoteRev[0:12])"
        ) | join("\n\n")
    ' "$work_dir/notifications.jsonl")
	if timeout --kill-after=5 "$hook_timeout" notify-send --app-name=flake-input-watcher \
		--icon=software-update-available -- 'Flake inputs 有更新' "$body" 9>&-; then
		while IFS= read -r key; do record_success "$key"; done \
			< <(jq -r '.key' "$work_dir/notifications.jsonl")
	else
		log 'notification delivery failed'
		failures=$((failures + 1))
	fi
fi

jq -s --arg flake "$flake_path" --argjson failures "$failures" \
	'{flakePath:$flake, inputs:., failures:$failures}' "$work_dir/results.jsonl"
((failures == 0))
